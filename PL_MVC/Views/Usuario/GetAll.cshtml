@model ML.Usuario
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="row">
        <div class="col-12 col-md-6 col-lg-4 mb-3">
            @Html.ActionLink("+", "Formulario", "Usuario", new { @class = "btn btn-success" })
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6 col-lg-4 mb-3">
            @if (Model.Usuarios != null)
            {
                <table class="table table-hover table-responsive">
                    <thead>
                        <tr>
                            <td> Estatus </td>
                            <td> Editar </td>
                            <td> Nombre de Usuario </td>
                            <td> Nombre </td>
                            <td> Direccion </td>
                            <td> Email </td>
                            <td> Password </td>
                            <td> Fecha de Nacimiento </td>
                            <td> Sexo </td>
                            <td> Telefono </td>
                            <td> Celular </td>

                            <td> CURP </td>
                            <td> Imagen </td>
                            <td> Rol </td>
                            <td> Eliminar </td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ML.Usuario usuario in Model.Usuarios)
                        {
                            <tr>
                                <input type="hidden" name="IdUsuario" value="@usuario.IdUsuario" />
                                <td>
                                    <span id="lblEstatus_@usuario.IdUsuario">@usuario.Estatus</span>
                                    <div class="form-check form-switch">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               role="switch"
                                               id="SwitchEstatus_@usuario.IdUsuario"
                                               @(usuario.Estatus ? "checked" : "")
                                               onchange="UpdateEstatus(@usuario.IdUsuario, this.checked)" />
                                    </div>
                                </td>
                                <td>@Html.ActionLink("Editar", "Formulario", "Usuario", new { IdUsuario = usuario.IdUsuario }, new { @class = "btn btn-warning" })</td>

                                <td>@usuario.UserName</td>
                                <td>@usuario.Nombre @usuario.ApellidoPaterno @usuario.ApellidoMaterno</td>
                                <td>
                                    @if (usuario.Direccion.Calle != "" || usuario.Direccion.NumeroInterior != "" || usuario.Direccion.NumeroExterior != ""
                                   || usuario.Direccion.Colonia.Nombre != "" || usuario.Direccion.Colonia.CodigoPostal != ""
                                   || usuario.Direccion.Colonia.Municipio.Nombre != "" || usuario.Direccion.Colonia.Municipio.Estado.Nombre != "")
                                    {
                                        @usuario.Direccion.Calle <i>,</i>
                                        @usuario.Direccion.NumeroExterior <i>,</i>
                                        @usuario.Direccion.NumeroInterior <i>,</i>
                                        @usuario.Direccion.Colonia.Nombre <i>,</i>
                                        @usuario.Direccion.Colonia.CodigoPostal <i>,</i>
                                        @usuario.Direccion.Colonia.Municipio.Nombre <i>,</i>
                                        @usuario.Direccion.Colonia.Municipio.Estado.Nombre <i>.</i>}
                                    else
                                    {
                                        <i>No tiene Direccion Completa</i>
                                    }
                                </td>
                                <td>@usuario.Email</td>
                                <td>@usuario.Password</td>
                                <td>@usuario.FechaNacimiento</td>
                                <td>@usuario.Sexo</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.Celular</td>

                                <td>@usuario.CURP</td>
                                <td>
                                    @if (usuario.Imagen != null)
                                    {
                                        <img id="imgUsuario" src="data:image/*;base64, @Convert.ToBase64String(usuario.Imagen)" width="50" height="50" />
                                    }
                                    else
                                    {

                                        <img id="imgUsuario" src="@Url.Content("~/Img/Default.png")"
                                             width="50" height="50" />
                                    }
                                </td>
                                <td>@usuario.Rol.Nombre</td>
                                <td>
                                    <a href="@Url.Action("Delete", "Usuario", new { IdUsuario = usuario.IdUsuario })" onclick="return confirm('Estas seguro que quieres eliminar a este usuario?')">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-question-octagon">A simple danger alert-check it out!</i>
                </div>
            }
            <span id="lblEstatusUpdate"></span>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-all"> @TempData["Success"] </i>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-x-square"> @TempData["Error"] </i>

                </div>
            }
            @if (TempData["Agregado"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-floppy"> @TempData["Agregado"] </i>

                </div>
            }
        </div>
    </div>
</div>
<h2>GetAll</h2>

<script src="~/Scripts/jquery-3.4.1.js">
</script>
<script>
    function UpdateEstatus(IdUsuario, Estatus) {
        $("#lblEstatusUpdate").text('').removeClass('alert alert-success alert-danger');
    $.ajax({
        type: 'GET',
        url: '@Url.Action("UpdateIdEstatus")',
        dataType: 'json',

        contentType: 'application/json',
        data: { idusuario: IdUsuario, estatus: Estatus },
        success: function (result) {
            if (result.Correct) {
                $("#lblEstatus_"+IdUsuario).text(''+Estatus);
                $("#lblEstatusUpdate").addClass('bi bi-check-all alert alert-success').text('Estatus Actualizado');
            }
            else {
                $("#lblEstatusUpdate").addClass('bi bi-x-square alert alert-danger').text('Hubo un Error al Actualizar el Estatus');
            }
        },
        error: function (ex) {
            alert('Failed.' + ex);
        }
    });
}
</script>