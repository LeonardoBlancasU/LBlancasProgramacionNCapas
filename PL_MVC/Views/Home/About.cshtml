@{
    ViewBag.Title = "Hola";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>
    <!--<h3>@ViewBag.Message</h3> -->
    <h3> Favor de contestar el siguiente Formulario</h3>
    <form>
        <div class="container">
            <div class="row">
                    <div class="col">
                        <label for="exampleInputEmail1">Nombre</label>
                    </div>
                    <div class="col"> <input type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp"> </div>
                    <div class="col">
                        <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
                    </div>
                <div class="w-100"></div>
                    <div class="col"><label for="exampleInputPassword1">Apellido Paterno</label> </div>
                    <div class="col">
                        <input type="text" class="form-control" id="exampleInputPassword1">
                    </div>
                    <div class="col">
                        <input type="checkbox" class="form-check-input" id="exampleCheck1">
                    </div>
                    <div class="col">
                        <label class="form-check-label" for="exampleCheck1">Check me out</label>
                    </div>
            </div>
        </div>
                <button type="submit" class="btn btn-primary">Submit</button>
</form>



    
    <!--<p>Se Bienvenido a la pagina</p> -->
</main>